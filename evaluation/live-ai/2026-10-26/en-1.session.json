      "summary": {
        "key": "event.interpretation",
        "params": {
          "title": "Order, Collapse, Silence"
        }
      },
      "data": {
        "understood": [
          "The piece opens in perfect geometric order.",
          "Order erodes gradually rather than breaking suddenly.",
          "The collapse reaches full chaos as the high point.",
          "It ends in complete silence and darkness.",
          "No specific mood was given; I read it as tense."
        ],
        "strategy": "Let order decay step by step through geometry and sound so the chaos feels earned, then cut everything away to make the final silence absolute."
      }

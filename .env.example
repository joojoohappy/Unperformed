# UNPERFORMED configuration. Copy what you need into your shell or a local .env
# (which is git-ignored). Never commit a real key.

# --- Live AI service (services/ai) ---------------------------------------
# Required for Live AI mode. Without it the studio runs in demo mode only.
ANTHROPIC_API_KEY=
# Claude model id. Must support structured outputs.
UNPERFORMED_MODEL=claude-opus-5-5
# Output effort for each call (low | medium | high).
UNPERFORMED_EFFORT=low
# Per-request timeout in seconds.
UNPERFORMED_TIMEOUT_S=60
# Total attempts when the model's output does not validate.
UNPERFORMED_MAX_ATTEMPTS=2
# Use the API's server-side model fallback when the primary model is unavailable (1 or 0).
UNPERFORMED_SERVER_FALLBACKS=1
# Optional API base URL override (for a gateway).
UNPERFORMED_ANTHROPIC_BASE_URL=
# Comma-separated CORS origins allowed to call the service.
UNPERFORMED_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Web studio (apps/web) ------------------------------------------------
# Where the dev server proxies /api to.
UNPERFORMED_AI_URL=http://127.0.0.1:8787
# Set to "off" for a static build with no Live AI service (e.g. GitHub Pages).
VITE_LIVE_AI=
